# BAO VE TIEN — copy to .env and fill in. Never commit .env.
# Values below are EMPTY on purpose.

# PayPal sandbox REST app credentials (same names as scripts/sandbox-payout-201.mjs).
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# PayPal webhook ID (Dashboard > My Apps & Credentials > Webhooks).
# Required for webhook signature verification; without it every webhook is rejected.
PAYPAL_WEBHOOK_ID=

# AI advisor — two providers behind one interface (SPEC §1.1).
# AI_PROVIDER=openai (default) or gemini. Without a key for the active
# provider the advisor returns HOLD with a rule-based score and makes
# no LLM call. Models are configurable; defaults are not requirements.
# A judge can also bring their own key at runtime (POST
# /api/treasury/advisor/config) — in-memory only, never saved or logged.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server port (default 3000).
PORT=3000
